package @PKG@;

import android.os.Build;
import android.os.Bundle;
import android.system.Os;
import android.system.OsConstants;
import android.util.Log;
import android.view.View;
import android.view.Window;
import android.view.WindowInsets;
import android.view.WindowInsetsController;
import android.view.WindowManager;

import java.io.File;
import java.io.FileDescriptor;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.io.OutputStream;

import org.libsdl.app.SDLActivity;

/**
 * The APK's entry point: SDLActivity's thread calls SDL_main (the game's main.c), and this supplies it the arguments
 * `vitarecomp run` gives on a desktop -- the memory image, the guest entry address and a call budget -- and the
 * environment a pack's RUN_ENV would. The images ship in the APK's assets and are unpacked once; the game's own data
 * (fs/app0) is the player's, beside them in the app's external files folder.
 */
public class NativActivity extends SDLActivity {
    private static final String TAG = "Nativ";
    private static final String BASE = "@BASE@";
    private static final String ENTRY = "@ENTRY@";
    private static final String TITLE_ID = "@TITLE_ID@";
    private static final String GAME_NAME = "@GAME_NAME@";
    private static final String[] MODULES = { @MODULES@ };
    private static final boolean HAS_SHADERS = @SHADERS@;

    /* Full-screen: the panel is 4:3 and every pixel belongs to the game. systemBars hidden with the transient-by-swipe
     * behaviour (a swipe up/down brings the clock/battery back for a moment, then they go again), re-applied when the
     * window regains focus or the activity resumes -- Android restores the bars on its own after a dialog, the lock
     * screen or a task switch. setDecorFitsSystemWindows(false) (API 30) lets the SDLSurface lay out under where the
     * bars were, so the drawable stays 1280x960; below 30 the equivalent SYSTEM_UI_FLAGs do it. */
    private void immersive(boolean first) {
        Window w = getWindow();
        if (w == null) return;
        if (Build.VERSION.SDK_INT >= 30) {
            if (first) w.setDecorFitsSystemWindows(false);
            WindowInsetsController c = w.getInsetsController();
            if (c != null) {
                c.hide(WindowInsets.Type.systemBars());
                c.setSystemBarsBehavior(WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
            }
        } else {
            w.getDecorView().setSystemUiVisibility(
                    View.SYSTEM_UI_FLAG_LAYOUT_STABLE
                    | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                    | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                    | View.SYSTEM_UI_FLAG_FULLSCREEN
                    | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                    | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY);
        }
        if (first && Build.VERSION.SDK_INT >= 28) {   /* draw into a notch/cutout rather than letterbox beside it */
            WindowManager.LayoutParams lp = w.getAttributes();
            lp.layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES;
            w.setAttributes(lp);
        }
    }

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        immersive(true);
    }

    @Override
    protected void onResume() {
        super.onResume();
        immersive(false);
    }

    @Override
    public void onWindowFocusChanged(boolean hasFocus) {
        super.onWindowFocusChanged(hasFocus);
        if (hasFocus) immersive(false);
    }

    private File images() {
        File d = new File(getFilesDir(), "images");
        d.mkdirs();
        return d;
    }

    private boolean copyAsset(String name, File dst) {
        if (dst.isFile() && dst.length() > 0) return true;
        try (InputStream in = getAssets().open(name); OutputStream out = new FileOutputStream(dst)) {
            byte[] b = new byte[1 << 20];
            int n;
            while ((n = in.read(b)) > 0) out.write(b, 0, n);
            return true;
        } catch (Exception e) {
            Log.e(TAG, "asset " + name, e);
            return false;
        }
    }

    private void put(String k, String v) {
        try {
            Os.setenv(k, v, true);
        } catch (Exception e) {
            Log.e(TAG, "setenv " + k, e);
        }
    }

    /** the game's own stderr (its logs, crashes and metrics) to a file beside the game data: Android sends fd 2 to
     * /dev/null otherwise, and an APK has no terminal to watch */
    private void redirectStdio() {
        try {
            File dir = getExternalFilesDir(null);
            if (dir == null) dir = getFilesDir();
            File log = new File(dir, "nativ.log");
            FileDescriptor fd = Os.open(log.getAbsolutePath(),
                    OsConstants.O_WRONLY | OsConstants.O_CREAT | OsConstants.O_TRUNC, 0666);
            Os.dup2(fd, 1);
            Os.dup2(fd, 2);
            Os.close(fd);
            put("RECOMP_LOG_FILE", log.getAbsolutePath());
        } catch (Exception e) {
            Log.e(TAG, "stdio redirect", e);
        }
    }

    @Override
    protected String[] getArguments() {
        redirectStdio();
        File images = images();
        copyAsset("images/" + BASE + ".img", new File(images, BASE + ".img"));

        StringBuilder mods = new StringBuilder();
        for (String m : MODULES) {
            String f = "mod_" + m + ".img";
            File dst = new File(images, f);
            if (copyAsset("images/" + f, dst)) {
                if (mods.length() > 0) mods.append(',');
                mods.append(dst.getAbsolutePath());
            }
        }

        File ext = getExternalFilesDir(null);
        if (ext == null) ext = getFilesDir();
        File fs = new File(ext, "fs");
        fs.mkdirs();

        put("RECOMP_FS", fs.getAbsolutePath());
        put("RECOMP_MODULES", mods.toString());
        put("RECOMP_TITLE", TITLE_ID);
        put("RECOMP_GAME_NAME", GAME_NAME);
        put("RECOMP_METRICS", "1");

        // a 4:3 screen (1280x960): use all of it rather than letterbox the Vita's 16:9 frame. The overlay's Display page
        // still offers fit/stretch/fill; a true 4:3 render is the port's camera work, not a window mode.
        android.util.DisplayMetrics dm = getResources().getDisplayMetrics();
        put("RECOMP_ASPECT_MODE", dm.heightPixels > 0 && (float) dm.widthPixels / dm.heightPixels < 1.6f ? "fill" : "fit");

        if (HAS_SHADERS && copyAsset("shaders.txt", new File(getFilesDir(), "shaders.txt"))) {
            put("RECOMP_SHADER_RECIPES_SHIPPED", new File(getFilesDir(), "shaders.txt").getAbsolutePath());
        }

        Log.i(TAG, "game data goes in " + fs.getAbsolutePath() + "/app0");
        return new String[]{ new File(images, BASE + ".img").getAbsolutePath(), ENTRY, "100000000000" };
    }
}
